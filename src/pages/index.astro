}
function drawPoissonZone(ctx, zone) {
  const lambda = 3.1, start = zone.x - zone.w * .40, step = (zone.w * .80) / 8, baseline = zone.y + zone.h * .34;
  ctx.lineWidth = 3.4 * Math.max(.6, zk); ctx.fillStyle = cTealInk;
  for (let k = 0; k < 8; k++) {
    const barHeight = Math.exp(-lambda) * Math.pow(lambda, k) / factorial(k) * 370 * zk;
    const x = start + k * step + step * .5;
    ctx.beginPath(); ctx.moveTo(x, baseline); ctx.lineTo(x, baseline - barHeight); ctx.stroke();
    ctx.beginPath(); ctx.arc(x, baseline - barHeight, 3.2 * Math.max(.6, zk), 0, TAU); ctx.fill();
  }
}
function drawExponentialZone(ctx, zone) {
  const startX = zone.x - zone.w * .43, endX = zone.x + zone.w * .43, baseline = zone.y + zone.h * .34;
  ctx.lineWidth = 4.5 * Math.max(.6, zk); ctx.beginPath();
  for (let x = startX; x <= endX; x += 2) {
    const y = baseline - zone.h * .77 * Math.exp(-(x - startX) / (31 * zk));
