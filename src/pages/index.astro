<a class="skip" href="#main">Skip to content</a>

<header class="nav" id="nav">
  <div class="nav-in">
    <a class="logo" href="#top" aria-label="Minicourse home"><img class="lg-l" src="/assets/Minicourse_light.png" width="3200" height="1800" alt="Minicourse: From Probability to Information"><img class="lg-d" src="/assets/Minicourse_dark.png" width="3200" height="1800" alt="Minicourse: From Probability to Information"></a>
    <nav aria-label="Primary" style="display:contents">
      <ul id="menu">
        <li><a href="#speakers">Speakers</a></li>
        <li><a href="#program">Program</a></li>
        <li><a href="#venue">Venue</a></li>
        <li><a href="#register">Register</a></li>
      </ul>
    </nav>
