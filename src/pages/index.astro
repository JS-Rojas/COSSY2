<style is:inline>
:root{
  /* Layout: a lecture poster. Brand and hook on the left, the figure on the right, and one ruled row of facts
     (when, where, who) closing the first screen. Every later section opens with the same ink rule. */
  --bg:#f3f1e9; --bg-soft:#e9eee9; --ink:#18272e;
  /* brand muted (#607177) is 4.4:1 on paper; nudged darker to clear 4.5:1 for body text */
  --muted:#54656b;
  --teal:#4e9698; --teal-strong:#2f777a; --teal-ink:#276669;
  --gold:#98813d; --gold-ink:#7a672b; --blue:#637f9e; --blue-ink:#47617e;
  --line:rgba(24,39,46,.16); --dotc:rgba(24,39,46,.42); --hover:rgba(152,129,61,.1); --tag:#2f777a;
  --dots:radial-gradient(circle,var(--dotc) .9px,transparent 1.3px);
  --f-display:"Newsreader",Georgia,serif; --f-text:"Inter Tight",system-ui,sans-serif; --f-mono:"IBM Plex Mono",ui-monospace,monospace;
  --gutter:16px; --nav-h:58px;
  --on-accent:#fff; --nav-bg:rgba(243,241,233,.88); --hatch:rgba(24,39,46,.12); --open-bgc:rgba(24,39,46,.07);
  --course-bgc:rgba(78,150,152,.15); --key-bgc:rgba(152,129,61,.22); --talk-bgc:rgba(99,127,158,.15); --conn:rgba(24,39,46,.5);
  --globe-fill:rgba(255,255,255,.35); --globe-line:rgba(24,39,46,.3); --globe-grid:rgba(24,39,46,.09);
  /* the footer and the Apply cell stay dark in both themes; logo tiles stay white because the logos are JPEGs on white */
  --foot-bg:#18272e; --foot-fg:#f3f1e9; --foot-accent:#a9d3d4; --foot-muted:#c8d1d4; --foot-line:rgba(243,241,233,.2); --tile:#fff; --tile-dim:none;
  color-scheme:light;
}
/* dark theme: --bg is the dark logo's own background, so the logo sits on the page without a box */
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#18272e;--bg-soft:#13212a;--ink:#edf1f5;--muted:#a6b1bc;--teal:#7ec7cc;--teal-strong:#7ec7cc;--teal-ink:#a9e1e3;--gold:#c5b46a;--gold-ink:#d6c57a;--blue:#8ea7c2;--blue-ink:#b3c7dc;--line:rgba(237,241,245,.14);--dotc:rgba(237,241,245,.36);--hover:rgba(197,180,106,.1);--tag:#4e9698;--tile-dim:brightness(.9);--on-accent:#0b161c;--nav-bg:rgba(24,39,46,.9);--hatch:rgba(237,241,245,.09);--open-bgc:rgba(237,241,245,.07);--course-bgc:rgba(126,199,204,.13);--key-bgc:rgba(197,180,106,.18);--talk-bgc:rgba(142,167,194,.13);--conn:rgba(237,241,245,.42);--globe-fill:rgba(255,255,255,.04);--globe-line:rgba(237,241,245,.28);--globe-grid:rgba(237,241,245,.08);--foot-bg:#0f1a20;--foot-fg:#edf1f5;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#18272e;--bg-soft:#13212a;--ink:#edf1f5;--muted:#a6b1bc;--teal:#7ec7cc;--teal-strong:#7ec7cc;--teal-ink:#a9e1e3;--gold:#c5b46a;--gold-ink:#d6c57a;--blue:#8ea7c2;--blue-ink:#b3c7dc;--line:rgba(237,241,245,.14);--dotc:rgba(237,241,245,.36);--hover:rgba(197,180,106,.1);--tag:#4e9698;--tile-dim:brightness(.9);--on-accent:#0b161c;--nav-bg:rgba(24,39,46,.9);--hatch:rgba(237,241,245,.09);--open-bgc:rgba(237,241,245,.07);--course-bgc:rgba(126,199,204,.13);--key-bgc:rgba(197,180,106,.18);--talk-bgc:rgba(142,167,194,.13);--conn:rgba(237,241,245,.42);--globe-fill:rgba(255,255,255,.04);--globe-line:rgba(237,241,245,.28);--globe-grid:rgba(237,241,245,.08);--foot-bg:#0f1a20;--foot-fg:#edf1f5;color-scheme:dark}
/* .lg-l shows in the light theme, .lg-d in the dark one (logos and the theme button's icon) */
.lg-d{display:none}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .lg-l{display:none}:root:not([data-theme="light"]) .lg-d{display:block}}
:root[data-theme="dark"] .lg-l{display:none}:root[data-theme="dark"] .lg-d{display:block}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.55 var(--f-text);overflow-x:clip;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3,p,dl,dd{margin:0}
[hidden]{display:none!important}
:focus-visible{outline:2px solid var(--teal-strong);outline-offset:3px;border-radius:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap{width:100%;max-width:1360px;margin:0 auto;padding-inline:var(--gutter)}
/* small caps label: the same voice as the logo's tagline. Mono is kept for times and dates only. */
.label{font:600 .72rem/1.25 var(--f-text);letter-spacing:.16em;text-transform:uppercase;color:var(--teal-ink)}
.skip{position:absolute;left:12px;top:-60px;background:var(--ink);color:var(--bg);padding:8px 14px;z-index:100;border-radius:4px}
.skip:focus{top:10px}
/* paper grain */
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:90;opacity:.05;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>")}

/* buttons and text links */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;padding:.8em 1.35em;border:1px solid var(--ink);border-radius:999px;background:transparent;color:var(--ink);
  font:500 .95rem/1 var(--f-text);text-decoration:none;white-space:nowrap;cursor:pointer;transition:background .25s,color .25s,border-color .25s}
.btn:hover{background:var(--ink);color:var(--bg)}
.btn.solid{background:var(--teal-strong);border-color:var(--teal-strong);color:var(--on-accent)}
.btn.solid:hover{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.btn.sm{padding:.68em 1.1em;font-size:.875rem}
.btn.lg{padding:1.02em 1.7em;font-size:1.05rem}
.ar{display:inline-block;transition:transform .25s}
a:hover>.ar{transform:translate(2px,-2px)}
.tlink{display:inline-flex;align-items:baseline;gap:.35em;padding-bottom:2px;font:500 .92rem/1.25 var(--f-text);text-decoration:none;
  background:linear-gradient(currentColor,currentColor) 0 100%/100% 1px no-repeat;transition:color .2s}
.tlink:hover{color:var(--teal-ink)}

/* nav: clear over the hero, gains its ground once the page moves; the small logo docks in when the big one has left */
header.nav{position:fixed;inset:0 0 auto 0;z-index:70;border-bottom:1px solid transparent;transition:background .3s,border-color .3s}
.nav.scrolled,.nav.open{background:var(--nav-bg);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom-color:var(--line)}
.nav-in{position:relative;display:flex;align-items:center;justify-content:space-between;height:var(--nav-h);max-width:1360px;margin:0 auto;padding-inline:var(--gutter)}
.nav .logo,.nav .right .btn{opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .3s,transform .3s,visibility .3s,background .25s,color .25s,border-color .25s}
.nav .logo{display:block;flex:none}
.nav.docked .logo,.nav.docked .right .btn{opacity:1;visibility:visible;transform:none}
.nav .logo img{height:28px;width:auto;max-width:none;margin-left:-4px}
@media(max-width:439px){.nav .now{display:none}}
.nav nav{display:contents}
.nav ul{display:none;list-style:none;margin:0;padding:0;gap:32px}
.nav ul a{display:block;padding:8px 0;font:500 .95rem/1 var(--f-text);text-decoration:none;
  background:linear-gradient(var(--teal-strong),var(--teal-strong)) 0 100%/0 1.5px no-repeat;transition:background-size .3s}
.nav ul a:hover,.nav ul a[aria-current="true"]{background-size:100% 1.5px}
.nav .right{display:flex;align-items:center;gap:8px}
.theme-btn,.menu-btn{width:40px;height:40px;border:1px solid var(--line);border-radius:50%;background:none;color:var(--ink);cursor:pointer;display:grid;place-items:center;padding:0;transition:border-color .25s,background .25s,color .25s}
.theme-btn:hover,.menu-btn:hover{border-color:var(--ink)}
.menu-btn i{position:relative;display:block;width:16px;height:1.5px;background:var(--ink);transform:translateY(-3px);transition:transform .3s}
.menu-btn i::after{content:"";position:absolute;left:0;top:6px;width:16px;height:1.5px;background:var(--ink);transition:transform .3s}
.nav.open .menu-btn i{transform:rotate(45deg)}
.nav.open .menu-btn i::after{transform:translateY(-6px) rotate(-90deg)}
.nav.open ul{display:flex;flex-direction:column;position:absolute;top:var(--nav-h);left:0;right:0;background:var(--bg);padding:8px var(--gutter) 20px;border-bottom:1px solid var(--line);gap:0}
.nav.open ul a{padding:14px 0;font-size:1.05rem;background:none;border-bottom:1px solid var(--line)}
@media(min-width:900px){
  :root{--gutter:32px;--nav-h:64px}
  .nav ul{display:flex;position:absolute;left:50%;transform:translateX(-50%)}
  .menu-btn{display:none}
  .nav .logo img{height:34px}
}

/* hero: copy and figure share the first screen; the facts row closes it */
.hero{position:relative;min-height:100svh;padding:calc(var(--nav-h) + 6px) 0 clamp(14px,2.6vh,28px);display:flex;overflow:clip}
.hero>.wrap{display:grid;grid-template:"copy" auto "facts" auto "fig" minmax(250px,1fr) / minmax(0,1fr);row-gap:clamp(18px,3vh,26px)}
.hero-copy{grid-area:copy;position:relative;z-index:3;padding-top:4px}
/* the logo file keeps 2.87% of padding on each side; the shift lines its mark up with the text edge */
.lockup{width:min(620px,100%,105vh);container-type:inline-size}
.lockup-in{position:relative;transform:translateX(-2.87%)}
.hero-logo{width:100%;height:auto}
/* "Modeling Complex Systems" completes the tagline drawn in the logo. On a wide logo it is set to the artwork's own measures
   (Inter SemiBold at 2.53% of the logo's width, tracked .32em, starting where the wordmark starts). Example: a 600px logo gives 15px type.
   On a narrow logo that would be too small to read, so it becomes a plain line under the logo. */
.lockup-sub{margin:2px 0 0 2.87%;font:600 .74rem/1.25 "Inter",var(--f-text);letter-spacing:.2em;text-transform:uppercase;color:var(--tag)}
@container (min-width:430px){
  .lockup-in{padding-bottom:1.6cqw}
  .lockup-sub{position:absolute;left:25.53cqw;top:18.08cqw;margin:0;font-size:2.53cqw;line-height:1;letter-spacing:.32em;white-space:nowrap}
}
h1.display{margin:clamp(12px,2.6vh,24px) 0 0 -.03em;font:400 clamp(1.75rem,min(2.9vw,6.4vh),2.6rem)/1.08 var(--f-display);letter-spacing:-.03em;text-wrap:balance}
h1 em{font-style:italic;color:var(--teal-ink);letter-spacing:-.035em}
.cta{margin-top:clamp(16px,3.4vh,30px);display:flex;flex-wrap:wrap;gap:10px}
.brain-wrap{grid-area:fig;position:relative;min-width:0;z-index:1}
.brain-wrap canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.facts{grid-area:facts;display:grid;grid-template-columns:minmax(0,1fr);border-top:1px solid var(--ink)}
.fact{display:grid;grid-template-columns:5.4rem minmax(0,1fr);column-gap:12px;padding:12px 0 13px;background:var(--dots) 0 100%/6px 3px repeat-x}
.fact dt{padding-top:.5em}
.fact dd b{display:block;font:400 clamp(1.2rem,2.05vw,1.65rem)/1.15 var(--f-display);letter-spacing:-.012em}
.fact dd span{display:block;margin-top:3px;font-size:.92rem;line-height:1.3;color:var(--muted)}
.fact.two dt{grid-row:1/3}
.fact.two dd{grid-column:2}
.fact.two dd+dd{margin-top:9px}
@media(min-width:900px){
  .hero>.wrap{grid-template:"copy fig" minmax(0,1fr) "facts facts" auto / minmax(0,1.05fr) minmax(0,.95fr);column-gap:24px;row-gap:clamp(8px,2vh,24px)}
  .hero-copy{align-self:center;padding:0 0 clamp(0px,2.4vh,26px)}
  .facts{grid-template-columns:minmax(0,1.1fr) minmax(0,1.1fr) minmax(0,1.8fr)}
  .fact{display:block;padding:13px 24px 0 0;background:none}
  .fact+.fact{padding-left:24px;border-left:1px solid var(--line)}
  .fact dt{padding:0;margin-bottom:8px}
  .fact.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:24px;padding-right:0}
  .fact.two dt{grid-row:auto;grid-column:1/-1}
  .fact.two dd{grid-column:auto}
  .fact.two dd+dd{margin-top:0}
}

/* sections */
section{position:relative}
.sec{padding:clamp(56px,8vw,96px) 0}
.sec.soft{background:var(--bg-soft)}
.sec-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 24px;margin-bottom:clamp(24px,4vw,40px);border-top:1px solid var(--ink);padding-top:14px}
.sec-head h2{font:400 clamp(1.9rem,3.6vw,2.75rem)/1.05 var(--f-display);letter-spacing:-.02em}
.sec-head .meta{color:var(--muted);font-size:.95rem}

/* speakers: globe + list. Row dividers are dotted, like the logo's own dots. */
.spk-wrap{display:grid;gap:18px;align-items:start}
.globe-wrap{position:relative;width:100%;max-width:440px;aspect-ratio:1;margin:0 auto}
.globe-wrap canvas{position:absolute;inset:0;width:100%;height:100%;cursor:grab;touch-action:pan-y}
.globe-wrap canvas:active{cursor:grabbing}
.spk-list{list-style:none;margin:0;padding:0}
.spk-list li{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:10px 24px;padding:16px 0 18px;background:var(--dots) 0 100%/6px 3px repeat-x}
.spk-list li::before{content:"";position:absolute;inset:0 -12px 3px;background:var(--hover);opacity:0;transition:opacity .25s;pointer-events:none}
.spk-list li:hover::before,.spk-list li:focus-within::before{opacity:1}
.spk-list li>*{position:relative}
.spk-list h3{font:400 1.5rem/1.1 var(--f-display);letter-spacing:-.012em}
.spk-list .aff{margin-top:4px;color:var(--muted);font-size:.95rem}
.spk-list .ttl{margin-top:6px;font:italic 400 1.1rem/1.25 var(--f-display)}
.spk-list .side{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 18px}
.spk-list .meta{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px}
.spk-list .kind{font:600 .7rem/1.25 var(--f-text);letter-spacing:.14em;text-transform:uppercase}
.k-key{color:var(--gold-ink)}.k-course{color:var(--teal-ink)}.k-talk{color:var(--blue-ink)}
.spk-list .slot{font:500 .78rem/1.3 var(--f-mono);color:var(--muted);text-decoration:underline;text-decoration-color:var(--dotc);text-underline-offset:3px;transition:color .2s}
.spk-list .slot:hover{color:var(--ink);text-decoration-color:currentColor}
/* how each speaker takes part: a filled dot for in person, a ring for online */
.mode{display:inline-flex;align-items:center;gap:6px;padding:3px 10px 3px 8px;border:1px solid var(--line);border-radius:999px;font:500 .78rem/1.2 var(--f-text);color:var(--muted);white-space:nowrap}
.mode::before{content:"";width:7px;height:7px;border-radius:50%;border:1.5px solid currentColor}
.mode.in{border-color:var(--teal-strong);color:var(--teal-ink)}
.mode.in::before{background:currentColor}
.spk-list .links{display:flex;gap:14px}
.spk-list li.key{padding-block:20px 22px}
.spk-list li.key h3{font-size:clamp(1.9rem,3vw,2.4rem);line-height:1}
.spk-list li:first-child{padding-top:4px}
@media(min-width:640px){
  .spk-list li{grid-template-columns:minmax(0,1fr) auto}
  .spk-list .side{flex-direction:column;flex-wrap:nowrap;align-items:flex-end;justify-content:flex-start;gap:10px;padding-top:.3em}
  .spk-list .meta{flex-direction:column;align-items:flex-end;gap:5px}
  .spk-list li.key .side{padding-top:.75em}
}
@media(min-width:900px){
  .spk-wrap{grid-template-columns:minmax(0,6fr) minmax(0,7fr);gap:40px}
  .globe-wrap{max-width:none;position:sticky;top:calc(var(--nav-h) + 20px)}
}

/* program: week grid. --ppm is pixels per minute; a block's top and height come from its start minute (--s, after 08:00) and duration (--d). */
.legend{display:flex;flex-wrap:wrap;gap:6px 22px;margin-bottom:16px;color:var(--muted);font-size:.9rem}
.legend i{display:inline-block;width:10px;height:10px;margin-right:8px;border-radius:2px;background:var(--c)}
.cal{--ppm:1.8px;--axis:52px;border-top:1px solid var(--ink)}
.cal-tabs{display:none}
/* the day names stay in view while the long grid scrolls under them */
.cal-head{display:grid;grid-template-columns:var(--axis) repeat(3,minmax(0,1fr));position:sticky;top:var(--nav-h);z-index:4;background:var(--bg);border-bottom:1px solid var(--line)}
.cal-grid{display:grid;grid-template-columns:var(--axis) minmax(0,1fr)}
.axis{position:relative;height:calc(480 * var(--ppm));margin-top:12px}
.axis span{position:absolute;right:10px;top:calc(var(--m) * var(--ppm));transform:translateY(-50%);font:400 .7rem var(--f-mono);color:var(--muted)}
.days{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
.cal-head h3{display:flex;align-items:baseline;gap:10px;padding:12px 12px 10px;font:300 clamp(2.5rem,4.4vw,3.4rem)/1 var(--f-display);letter-spacing:-.02em}
.cal-head h3 span{font:600 .72rem/1 var(--f-text);letter-spacing:.16em;text-transform:uppercase;color:var(--teal-ink)}
.day ol{position:relative;height:calc(480 * var(--ppm));margin:12px 0 13px;padding:0;list-style:none;border-left:1px solid var(--line);
  background:linear-gradient(var(--line) 1px,transparent 1px) 0 0/100% calc(60 * var(--ppm));box-shadow:0 1px 0 var(--line)}
.blk{position:absolute;left:6px;right:6px;top:calc(var(--s) * var(--ppm) + 1px);height:calc(var(--d) * var(--ppm) - 2px);overflow:hidden;
  padding:6px 10px 4px;border-left:4px solid var(--c);background:linear-gradient(var(--bgc),var(--bgc)),var(--bg);line-height:1.2;z-index:1}
.blk time{display:block;font:500 .7rem var(--f-mono);letter-spacing:.04em;color:var(--muted)}
.blk b{display:block;font:400 1.15rem/1.12 var(--f-display);margin-top:2px}
.blk span{display:block;font-size:.84rem;color:var(--muted);margin-top:2px}
.blk em{font:italic 400 .92rem var(--f-display);color:var(--ink)}
.course{--c:var(--teal-strong);--bgc:var(--course-bgc)}
.keynote{--c:var(--gold);--bgc:var(--key-bgc)}
.talk{--c:var(--blue);--bgc:var(--talk-bgc)}
.open{--c:var(--ink);--bgc:var(--open-bgc)}
.brk{display:flex;align-items:center;gap:10px;padding:0 10px;border:0;background:repeating-linear-gradient(135deg,transparent 0 6px,var(--hatch) 6px 7px),var(--bg);color:var(--muted)}
.brk time,.brk b{display:inline;margin:0;font:500 .7rem var(--f-mono);letter-spacing:.04em}
.brk b{font-family:var(--f-text);font-size:.82rem;letter-spacing:0}
.lunch-d{display:none}
.lunch{position:absolute;left:6px;right:6px;top:calc(12px + 240 * var(--ppm) + 1px);height:calc(120 * var(--ppm) - 2px);z-index:1;display:flex;align-items:center;justify-content:center;
  background:var(--bg) repeating-linear-gradient(135deg,transparent 0 6px,var(--hatch) 6px 7px);color:var(--muted)}
.lunch span{display:flex;align-items:baseline;gap:10px;background:var(--bg);padding:5px 12px;font-size:.9rem}
.lunch time{font:500 .74rem var(--f-mono)}
.blk.flash{animation:flash 2.4s ease-out}
@keyframes flash{0%,55%{box-shadow:0 0 0 2px var(--gold),0 0 0 7px var(--hover)}100%{box-shadow:0 0 0 2px transparent,0 0 0 7px transparent}}
.note{margin-top:16px;color:var(--muted);font-size:.92rem}
/* phones: one day at a time. The three days sit side by side in a snap scroller and the day tabs move it. Wide screens have no tabs. */
@media(max-width:759px){
  .cal{--ppm:1.75px;--axis:46px}
  .cal-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;position:sticky;top:var(--nav-h);z-index:5;padding:10px 0;background:var(--bg)}
  .cal-tabs button{display:flex;align-items:baseline;justify-content:center;gap:6px;padding:8px 6px 9px;border:1px solid var(--line);border-radius:999px;background:none;color:var(--muted);font:500 .92rem/1 var(--f-text);cursor:pointer}
  .cal-tabs b{font:400 1.35rem/1 var(--f-display);color:var(--ink)}
  .cal-tabs button[aria-current="true"]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
  .cal-tabs button[aria-current="true"] b{color:var(--bg)}
  .days{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
  .days::-webkit-scrollbar{display:none}
  .day{flex:0 0 100%;scroll-snap-align:start}
  .cal-head,.lunch{display:none}
  .day ol{margin-top:8px}
  .axis{margin-top:8px}
  .lunch-d{display:flex}
}

/* committee */
.com-grid{display:grid;gap:0 32px;grid-template-columns:1fr}
.com{padding:16px 0;background:var(--dots) 0 100%/6px 3px repeat-x}
.com h3{font:400 1.35rem/1.1 var(--f-display)}
@media(min-width:700px){.com-grid{grid-template-columns:1fr 1fr}}
@media(min-width:1100px){.com-grid{grid-template-columns:repeat(3,1fr)}}

/* venue and registration: one ruled panel, the same three-part grammar as the hero's facts row */
.close{display:grid;border:1px solid var(--ink)}
.close>div{display:flex;flex-direction:column;align-items:flex-start;padding:20px 18px 24px}
.close>div+div{border-top:1px solid var(--ink)}
.close h3{margin:10px 0 6px;font:400 clamp(1.45rem,2.3vw,1.85rem)/1.12 var(--f-display);letter-spacing:-.012em}
.close p{color:var(--muted)}
.close .tlink{margin-top:auto}
.close p+.tlink{padding-top:0}
.close>div>p:not(.label){margin-bottom:18px}
.apply{background:var(--foot-bg);color:var(--foot-fg)}
.apply .label{color:var(--foot-accent)}
.apply p{color:var(--foot-muted)}
.apply-row{display:flex;flex-wrap:wrap;align-items:center;gap:16px 20px;margin-top:12px}
.apply-row p{margin-bottom:0}
.apply-row img{width:116px;height:116px;border-radius:4px;background:var(--tile);padding:7px}
.apply-row .btn{margin-top:12px}
.apply .btn.solid:hover{background:var(--foot-fg);border-color:var(--foot-fg);color:var(--foot-bg)}
.partners{margin-top:clamp(40px,6vw,64px)}
.p-grid{display:grid;gap:14px;grid-template-columns:1fr 1fr;margin-top:14px}
.p-grid figure{margin:0}
.p-grid .tile{filter:var(--tile-dim);background:var(--tile);border:1px solid var(--line);border-radius:6px;height:96px;display:grid;place-items:center;padding:12px}
.p-grid img{max-height:72px;width:auto;object-fit:contain}
.p-grid figcaption{margin-top:8px;font-size:.85rem;line-height:1.35;color:var(--muted)}
@media(min-width:900px){
  .close{grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.35fr)}
  .close>div{padding:22px 26px 28px}
  .close>div+div{border-top:0;border-left:1px solid var(--ink)}
  .p-grid{grid-template-columns:repeat(4,1fr)}
}

/* footer */
footer{background:var(--foot-bg);color:var(--foot-fg);padding:clamp(40px,6vw,64px) 0 26px}
.foot-top{display:grid;gap:28px}
footer .big{font:300 clamp(1.6rem,3.4vw,2.6rem)/1.1 var(--f-display);letter-spacing:-.02em;text-wrap:balance}
footer .big em{display:block;color:var(--foot-accent)}
.foot-facts{margin-top:18px;display:flex;flex-wrap:wrap;gap:6px 28px;font:500 .8rem/1.4 var(--f-mono);color:var(--foot-muted)}
.foot-nav{display:flex;flex-wrap:wrap;gap:10px 26px;list-style:none;margin:0;padding:0;font-size:.95rem}
.foot-nav a,footer .copy a{text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;padding-bottom:2px;transition:background-size .3s}
.foot-nav a:hover,footer .copy a:hover{background-size:100% 1px}
footer .copy{margin-top:36px;padding-top:14px;border-top:1px solid var(--foot-line);display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;font-size:.85rem;color:var(--foot-muted)}
@media(min-width:900px){.foot-top{grid-template-columns:minmax(0,1fr) auto;align-items:end}}

@media(prefers-reduced-motion:reduce){
  .btn,.ar,.spk-list li::before,.nav,.nav .logo,.nav .right .btn{transition:none}
}
</style>
</head>
