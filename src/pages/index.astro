}
function drawHero(t) {
  const { ctx, w, h } = B;
  if (!t0) t0 = t;
  const rev = reduce ? 2 : (t - t0) / 1500;               // reveal sweep from top-left, then settles
  sx += (mx - sx) * .16; sy += (my - sy) * .16;
  ctx.clearRect(0, 0, w, h);
  drawConnectors(ctx);
  ctx.save(); ctx.strokeStyle = cTealInk; ctx.lineCap = "round";
  for (const z of zones) (z.type === "gaussian" ? drawGaussianZone : z.type === "poisson" ? drawPoissonZone : drawExponentialZone)(ctx, z);
  ctx.restore();
  // particle brain (prototype A): particles gather onto the outline, jitter, and move away from the cursor
  const g = reduce ? 1 : clamp((t - t0) / 1800, 0, 1), R2 = 90 * 90, tl = [], gl = [];
  for (const d of dots) {
    const e = easeOutCubic(clamp((g - d.d) / (1 - d.d), 0, 1)), j = reduce ? 0 : Math.sin(t / 1000 * d.f + d.ph) * .7;
    const x = lerp(d.sx0, d.x, e) + j, y = lerp(d.sy0, d.y, e) + j * .6, dx = x - sx, dy = y - sy, d2 = dx * dx + dy * dy;
    let tx = 0, ty = 0;
    if (!reduce && d2 < R2 && d2 > .01) { const dd = Math.sqrt(d2), f = Math.pow(1 - dd / 90, 2) * 26; tx = dx / dd * f; ty = dy / dd * f; }
    d.ox += (tx - d.ox) * .14; d.oy += (ty - d.oy) * .14;
    (d.gold ? gl : tl).push(x + d.ox, y + d.oy, d.r);
  }
  for (const [arr, col, al] of [[tl, cTeal, .85], [gl, cGold, .95]]) {
    ctx.fillStyle = col; ctx.globalAlpha = al; ctx.beginPath();
    for (let i = 0; i < arr.length; i += 3) { ctx.moveTo(arr[i] + arr[i + 2], arr[i + 1]); ctx.arc(arr[i], arr[i + 1], arr[i + 2], 0, TAU); }
    ctx.fill();
  }
  ctx.globalAlpha = 1;
  // five sampling sites, gold rings that pulse
  const pulse = reduce ? 0 : (t / 1600) % 1;
  for (const z of zones) {
    const r = 5.4 * bScale;
    ctx.fillStyle = cBg; ctx.strokeStyle = cGold; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(z.anchor.x, z.anchor.y, r, 0, TAU); ctx.fill(); ctx.stroke();
    if (!reduce && rev > 1.5) { ctx.globalAlpha = 1 - pulse; ctx.beginPath(); ctx.arc(z.anchor.x, z.anchor.y, r + pulse * r * 2.4, 0, TAU); ctx.stroke(); ctx.globalAlpha = 1; }
  }
  // particles flow in from the canvas edges, settle on their zone's curve, then are replaced
  ctx.fillStyle = cTeal; ctx.globalAlpha = .45;
  for (const p of particles) {
    if (p.state === "moving") {
      p.progress += p.speed;
      if (p.progress < 0) continue;
      const e = easeOutCubic(clamp(p.progress, 0, 1));
      p.x = lerp(p.startX, p.tx, e); p.y = lerp(p.startY, p.ty, e);
      if (p.progress >= 1) p.state = "linger";
    } else if (!reduce) {
      p.linger -= 1;
      p.x += Math.sin(p.linger * .045) * .045; p.y += Math.cos(p.linger * .037) * .045;
      if (p.linger <= 0) Object.assign(p, makeParticle(p.zoneIndex, false));
    }
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, TAU); ctx.fill();
  }
  ctx.globalAlpha = 1;
}
hero.addEventListener("pointermove", e => {
  const c = bCan.getBoundingClientRect();
  mx = e.clientX - c.left; my = e.clientY - c.top;
  if (sx < -900) { sx = mx; sy = my; }
});
hero.addEventListener("pointerleave", () => { mx = my = -999; });
buildScene();
onResize(bCan, buildScene);
if (!reduce) runWhenVisible(hero, drawHero);

/* ---------- theme: follows the system setting until the visitor picks one ---------- */
const root = document.documentElement, themeBtn = $("#themeBtn"), mq = matchMedia("(prefers-color-scheme: dark)");
const isDark = () => root.dataset.theme ? root.dataset.theme === "dark" : mq.matches;
function syncTheme() {
  const dark = isDark();
  themeBtn.setAttribute("aria-pressed", String(dark));
  themeBtn.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
  buildScene();
}
themeBtn.addEventListener("click", () => {
  root.dataset.theme = isDark() ? "light" : "dark";
  try { localStorage.setItem("mc-theme", root.dataset.theme); } catch (e) {}
  syncTheme();
});
if (mq.addEventListener) mq.addEventListener("change", syncTheme);
syncTheme();

/* ---------- globe ---------- */
// Very coarse continent outlines (lon, lat). Enough to read as land at ~11px dot spacing.
const LAND = [
[[-168,66],[-130,70],[-95,72],[-80,68],[-62,58],[-55,48],[-70,42],[-76,35],[-80,25],[-83,29],[-90,29],[-97,26],[-97,19],[-90,16],[-83,9],[-78,8],[-86,12],[-95,16],[-105,20],[-110,24],[-115,30],[-118,34],[-124,40],[-124,48],[-135,58],[-150,60],[-165,60]],
[[-78,8],[-72,12],[-62,10],[-52,5],[-50,0],[-40,-3],[-35,-8],[-39,-18],[-48,-26],[-58,-35],[-65,-42],[-68,-52],[-72,-52],[-74,-42],[-71,-30],[-70,-18],[-76,-14],[-81,-5],[-80,0],[-77,4]],
[[-17,15],[-16,22],[-10,30],[-6,35],[10,37],[20,32],[32,31],[35,28],[43,12],[51,12],[40,-3],[40,-15],[35,-25],[27,-34],[18,-34],[12,-18],[13,-6],[9,4],[-8,4],[-15,10]],
[[-10,36],[-9,43],[-2,44],[-5,48],[2,51],[8,54],[10,58],[5,62],[15,69],[30,71],[60,69],[80,73],[110,77],[140,72],[170,70],[180,66],[160,58],[155,50],[142,46],[135,43],[128,38],[126,35],[122,40],[121,31],[118,24],[108,21],[106,10],[100,13],[103,1],[98,8],[93,18],[88,22],[80,15],[77,8],[72,20],[66,25],[57,26],[50,30],[56,25],[59,22],[52,16],[43,13],[35,28],[34,31],[27,37],[26,40],[23,36],[19,40],[14,45],[12,44],[16,38],[9,44],[3,43],[-2,37]],
[[130,32],[132,35],[138,38],[141,41],[142,38],[140,35],[135,33]],
[[114,-22],[122,-18],[130,-12],[137,-12],[142,-11],[146,-19],[153,-27],[150,-37],[141,-38],[135,-34],[116,-35],[114,-27]],
[[-5,50],[1,51],[-2,56],[-5,58],[-6,55]],
[[-55,60],[-45,60],[-20,70],[-20,82],[-60,82],[-70,76]]];
const inPoly = (lon, lat, p) => {
  let c = false;
  for (let i = 0, j = p.length - 1; i < p.length; j = i++) {
    const [xi, yi] = p[i], [xj, yj] = p[j];
    if ((yi > lat) !== (yj > lat) && lon < (xj - xi) * (lat - yi) / (yj - yi) + xi) c = !c;
  }
  return c;
};
const D2R = Math.PI / 180;
// world unit vector for (lat, lon in degrees); x towards (0,0), y towards 90E, z north
const vec = (lat, lon) => [Math.cos(lat * D2R) * Math.cos(lon * D2R), Math.cos(lat * D2R) * Math.sin(lon * D2R), Math.sin(lat * D2R)];
const land = [];
{ // Fibonacci sphere, keep land points only
  const N = 6500;
  for (let i = 0; i < N; i++) {
    const lat = Math.asin(1 - 2 * (i + .5) / N) / D2R, lon = ((i * 137.508) % 360) - 180;
    if (LAND.some(p => inPoly(lon, lat, p))) land.push(vec(lat, lon));
  }
}
/* One marker per place. `names` lists [speaker id, label] pairs, so Trieste carries two names.
   Example: hovering the list row data-id="paredes" highlights the Trieste marker, the Trieste arc and the "Paredes · SISSA" line. */
const PLACES = [
  { lat: 40.35, lon: -74.66, arc: true, names: [["bialek", "Bialek · Princeton"]] },
  { lat: -33.05, lon: -71.62, arc: true, names: [["villagomez", "Villagomez · UV"]] },
  { lat: 26.46, lon: 127.83, arc: true, names: [["velez", "Velez · OIST"]] },
  { lat: 45.68, lon: 13.75, arc: true, names: [["marsili", "Marsili · ICTP"], ["paredes", "Paredes · SISSA"]] },
  { lat: -23.56, lon: -46.73, arc: true, names: [["jose", "Ayala · USP"]] },
  { lat: 39.64, lon: 2.65, arc: true, names: [["carpio", "Carpio · IFISC"]] },
  { lat: 0.40, lon: -78.17, arc: false, hub: true, names: [["cosenza", "Cosenza · Urcuquí"]] }]; // Urcuquí: the arcs' destination, no arc of its own
PLACES.forEach(p => p.v = vec(p.lat, p.lon));
const HUB = PLACES.find(p => p.hub);

const gCan = $("#globe");
let G = null, lon0 = -60 * D2R, drag = false, hl = null;
const TILT = 18 * D2R;
function buildGlobe() { G = fit(gCan); if (reduce) drawGlobe(0); }
// world vector -> {x,y in unit disc coords, d depth}; viewer sits on +x after rotating by lon0, then tilted.
// vis means "on the near side" (depth > 0). Points behind the globe are never drawn, even when they project
// outside the disc: that is what made the OIST arc loop out behind the globe before.
function view(v) {
  const c = Math.cos(lon0), s = Math.sin(lon0);
  const x1 = v[0] * c + v[1] * s, y1 = -v[0] * s + v[1] * c, z1 = v[2];
  const ct = Math.cos(TILT), st = Math.sin(TILT);
  const depth = x1 * ct + z1 * st, sy = z1 * ct - x1 * st;
  return { x: y1, y: sy, d: depth, vis: depth > 0 };
}
function line(ctx, pts, R, cx, cy) { // draw polyline, breaking where points are hidden; clipped to the globe disc
  ctx.save(); ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU); ctx.clip();
  let pen = false; ctx.beginPath();
  for (const p of pts) {
    if (!p.vis) { pen = false; continue; }
    const X = cx + p.x * R, Y = cy - p.y * R;
    pen ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y); pen = true;
  }
  ctx.stroke(); ctx.restore();
}
function arcPoints(a, b, n) {
  const om = Math.acos(clamp(a[0] * b[0] + a[1] * b[1] + a[2] * b[2], -1, 1)), so = Math.sin(om);
  const lift = .32 * Math.min(1, om / 1.6), out = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n, k1 = Math.sin((1 - t) * om) / so, k2 = Math.sin(t * om) / so, h = 1 + lift * Math.sin(Math.PI * t);
    out.push(view([(a[0] * k1 + b[0] * k2) * h, (a[1] * k1 + b[1] * k2) * h, (a[2] * k1 + b[2] * k2) * h]));
  }
  return out;
}
const placeOn = p => !!hl && p.names.some(n => n[0] === hl);
function drawGlobe(t) {
  const { ctx, w, h } = G;
  const hlPlace = PLACES.find(placeOn);
  if (hlPlace) { // turn the globe towards the highlighted speaker by the shortest way round
    const d = hlPlace.lon * D2R - lon0;
    lon0 += Math.atan2(Math.sin(d), Math.cos(d)) * (reduce ? 1 : .08);
  } else if (!drag && !reduce) lon0 += .0009;
  const R = w * .34, cx = w / 2, cy = h / 2;
  const ink = css("--ink"), teal = css("--teal-strong"), gold = css("--gold-ink");
  ctx.clearRect(0, 0, w, h);
  ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU);
  ctx.fillStyle = css("--globe-fill"); ctx.fill();
  ctx.strokeStyle = css("--globe-line"); ctx.lineWidth = 1; ctx.stroke();
  // graticule every 30 degrees
  ctx.strokeStyle = css("--globe-grid");
  for (let lo = -180; lo < 180; lo += 30) { const pts = []; for (let la = -90; la <= 90; la += 6) pts.push(view(vec(la, lo))); line(ctx, pts, R, cx, cy); }
  for (let la = -60; la <= 60; la += 30) { const pts = []; for (let lo = -180; lo <= 180; lo += 6) pts.push(view(vec(la, lo))); line(ctx, pts, R, cx, cy); }
  // land dots, fading toward the limb
  ctx.fillStyle = teal;
  for (const v of land) {
    const p = view(v); if (p.d <= 0) continue;
    ctx.globalAlpha = .25 + .75 * p.d; ctx.beginPath(); ctx.arc(cx + p.x * R, cy - p.y * R, 1.5 + p.d * .6, 0, TAU); ctx.fill();
  }
  ctx.globalAlpha = 1;
  // arcs to Urcuquí; the highlighted one is drawn last and thicker
  ctx.strokeStyle = gold; ctx.lineCap = "round";
  const arcs = PLACES.filter(p => p.arc).sort((a, b) => placeOn(a) - placeOn(b));
  for (const p of arcs) {
    const on = placeOn(p);
    ctx.globalAlpha = on ? 1 : hl ? .22 : .6; ctx.lineWidth = on ? 3 : 1.6;
    line(ctx, arcPoints(p.v, HUB.v, 56), R, cx, cy);
  }
  ctx.globalAlpha = 1;
  // markers, then labels laid out per side so neighbours (Trieste, Palma) do not overlap
  const small = w < 420, fs = small ? 10 : 11, lh = fs + 3;
  const items = [];
  for (const p of PLACES) {
    const q = view(p.v); if (q.d < .05) continue;
    const X = cx + q.x * R, Y = cy - q.y * R, on = placeOn(p);
    const al = clamp(q.d * 3, 0, 1) * (hl && !on ? .4 : 1);
    ctx.globalAlpha = al;
    if (p.hub) {
      const ph = reduce ? 0 : (t / 1800) % 1;
      ctx.strokeStyle = teal; ctx.lineWidth = 1.5; ctx.globalAlpha = al * (1 - ph); ctx.beginPath(); ctx.arc(X, Y, 6 + ph * 16, 0, TAU); ctx.stroke(); ctx.globalAlpha = al;
    }
    ctx.fillStyle = p.hub ? teal : on ? gold : ink; ctx.beginPath(); ctx.arc(X, Y, p.hub ? 6 : on ? 5.5 : 3.5, 0, TAU); ctx.fill();
    if (on) { ctx.strokeStyle = gold; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(X, Y, 10, 0, TAU); ctx.stroke(); }
    ctx.globalAlpha = 1;
    // measure with the bold font so a highlighted label cannot grow past the edge
    ctx.font = `500 ${fs}px "IBM Plex Mono",monospace`;
    const tw = Math.max(...p.names.map(n => ctx.measureText(n[1]).width));
    let side = X > cx ? 1 : -1;
    if (side === 1 && X + 9 + tw > w - 2) side = -1;
    else if (side === -1 && X - 9 - tw < 2) side = 1;
    items.push({ p, X, Y, al, on, side, tw, hgt: p.names.length * lh, yc: Y });
  }
  for (const side of [-1, 1]) {
    const col = items.filter(i => i.side === side).sort((a, b) => a.Y - b.Y);
    col.forEach((it, i) => { if (i) { const pr = col[i - 1]; it.yc = Math.max(it.yc, pr.yc + pr.hgt / 2 + it.hgt / 2 + 2); } });
  }
  ctx.textBaseline = "middle";
  for (const it of items) {
    ctx.textAlign = it.side === 1 ? "left" : "right";
    it.p.names.forEach(([id, label], i) => {
      const lit = hl === id;
      ctx.globalAlpha = it.al; ctx.fillStyle = lit ? gold : ink;
      ctx.font = `${lit || it.p.hub ? 600 : 500} ${fs}px "IBM Plex Mono",monospace`;
      ctx.fillText(label, it.X + it.side * 10, it.yc - it.hgt / 2 + (i + .5) * lh);
    });
  }
  ctx.globalAlpha = 1;
}
let lastX = 0;
gCan.addEventListener("pointerdown", e => { drag = true; lastX = e.clientX; gCan.setPointerCapture(e.pointerId); });
gCan.addEventListener("pointermove", e => { if (!drag) return; lon0 -= (e.clientX - lastX) / (G.w * .34); lastX = e.clientX; if (reduce) drawGlobe(0); });
["pointerup", "pointercancel"].forEach(ev => gCan.addEventListener(ev, () => { drag = false; }));
buildGlobe();
onResize(gCan, buildGlobe);
if (!reduce) runWhenVisible(gCan, drawGlobe);
// list rows drive the highlight; hovering or focusing a row turns the globe to that speaker
function setHl(id) { hl = id; if (reduce && G) drawGlobe(0); }
$$("#spkList li").forEach(li => {
  li.addEventListener("mouseenter", () => setHl(li.dataset.id));
  li.addEventListener("mouseleave", () => setHl(null));
  li.addEventListener("focusin", () => setHl(li.dataset.id));
  li.addEventListener("focusout", e => { if (!li.contains(e.relatedTarget)) setHl(null); });
});

/* ---------- program: week grid ----------
   Times are minutes after 08:00. Example: ["14:00" keynote] is start 360, duration 50, so top = 360 * 1.8px = 648px
   and height = 90px - 2px inside a 864px day column. The same morning repeats each day; Lunch is drawn once across all columns. */
const hm = m => { m += 480; return String(m / 60 | 0).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0"); };
const MORNING = [[30, 90, "course", "Intro to Probability", "Antonio Villagomez (UV, Chile)"], [120, 30, "brk", "Coffee break"],
  [150, 90, "course", "Models from Information Principles", "Juan Velez (OIST, Japan)"]];
const DAYS = [
  { n: 14, dow: "Mon", name: "Monday", pre: [[0, 30, "open", "Opening Ceremony"]], pm: [360, "keynote", "Keynote Lecture 1", "Matteo Marsili (ICTP, Italy)", "Lost in Retraining"], tk: ["Talk 1", "Arianna Paredes (SISSA · OGS, Italy)"] },
  { n: 15, dow: "Tue", name: "Tuesday", pre: [], pm: [360, "talk", "Talk 2", "Mario Cosenza (Yachay Tech, Ecuador)", ""], tk: ["Talk 3", "María José Ayala Bolagay (USP, Brazil)"] },
  { n: 16, dow: "Wed", name: "Wednesday", pre: [], pm: [360, "keynote", "Keynote Lecture 2", "William Bialek (Princeton, USA)", ""], tk: ["Talk 4", "Mateo Carpio (IFISC, Spain)"] }];
function blk([s, d, type, title, who, quote]) {
  const time = `<time>${hm(s)}–${hm(s + d)}</time>`;
  if (type === "brk") return `<li class="blk brk" style="--s:${s};--d:${d}">${time}<b>${title}</b></li>`;
  return `<li class="blk ${type}" style="--s:${s};--d:${d}">${time}<b>${title}</b>${quote ? `<span><em>“${quote}”</em></span>` : ""}${who ? `<span>${who}</span>` : ""}</li>`;
}
$("#cal").innerHTML =
  `<div class="cal-head" aria-hidden="true"><div></div>${DAYS.map(d => `<h3>${d.n}<span>${d.dow}</span></h3>`).join("")}</div>
   <div class="cal-body"><div class="axis" aria-hidden="true">${Array.from({ length: 9 }, (_, i) => `<span style="--m:${i * 60}">${hm(i * 60)}</span>`).join("")}</div>
   ${DAYS.map(d => `<ol aria-label="${d.name} ${d.n} December 2026">${[...d.pre, ...MORNING,
      [d.pm[0], 50, d.pm[1], d.pm[2], d.pm[3], d.pm[4]], [410, 20, "brk", "Coffee break"], [430, 50, "talk", d.tk[0], d.tk[1]]].map(blk).join("")}</ol>`).join("")}
   <p class="lunch"><b>Lunch</b><time class="mono">12:00–14:00 daily</time></p></div>`;

/* ---------- committee ---------- */
$("#com").innerHTML = Array.from({ length: 6 }, () =>
  `<article class="com"><h3>Committee member</h3><a class="btn sm" href="#" data-todo="linkedin">LinkedIn <span class="ar" aria-hidden="true">↗</span></a></article>`).join("");

/* ---------- entrance + scroll reveals ---------- */
if (hasG && !reduce) {
  gsap.from("h1.display", { y: 20, opacity: 0, duration: .9, ease: "power3.out", delay: .1 });
  gsap.from([".hero-logo", ".secondary", ".when", ".cta"], { y: 20, opacity: 0, duration: .8, ease: "power3.out", stagger: .08, delay: .3 });
  gsap.from(".brain-wrap", { opacity: 0, duration: 1.2, delay: .4 });
  if (hasST) $$("[data-reveal]").forEach(el => gsap.from(el, { y: 28, opacity: 0, duration: .8, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 92%", once: true } }));
}
})();
</script>
