  }
  const lambda = 1 / (29 * zk);
  const ex = clamp(exponentialSample(lambda), 0, zone.w * .82);
  const curveY = baseline - zone.h * .77 * Math.exp(-ex / (31 * zk));
  return { x: zone.x - zone.w * .43 + ex, y: curveY + randn() * 6 * zk };
}
function drawGaussianZone(ctx, zone) {
  const sigma = zone.w * .22, baseline = zone.y + zone.h * .34;
  ctx.lineWidth = 4.5 * Math.max(.6, zk); ctx.beginPath();
  for (let x = -zone.w * .44; x <= zone.w * .44; x += 2) {
    const y = baseline - zone.h * .72 * Math.exp(-.5 * Math.pow(x / sigma, 2));
    x === -zone.w * .44 ? ctx.moveTo(zone.x + x, y) : ctx.lineTo(zone.x + x, y);
