<style is:inline>
:root{
  --bg:#f3f1e9; --bg-soft:#e9eee9; --ink:#18272e;
  /* brand muted (#607177) is 4.4:1 on paper; nudged darker to clear 4.5:1 for body text */
  --muted:#54656b;
  --teal:#4e9698; --teal-strong:#2f777a; --teal-ink:#276669;
  --gold:#98813d; --gold-ink:#7a672b; --blue:#637f9e;
  --line:rgba(24,39,46,.16);
  --f-display:"Newsreader",Georgia,serif; --f-text:"Inter Tight",system-ui,sans-serif; --f-mono:"IBM Plex Mono",ui-monospace,monospace;
  --gutter:16px; --nav-h:58px;
  --on-accent:#fff; --nav-bg:rgba(243,241,233,.86); --hatch:rgba(24,39,46,.12); --open-bgc:rgba(24,39,46,.07);
  --course-bgc:rgba(78,150,152,.15); --key-bgc:rgba(152,129,61,.22); --talk-bgc:rgba(99,127,158,.15); --conn:rgba(24,39,46,.5);
  --globe-fill:rgba(255,255,255,.35); --globe-line:rgba(24,39,46,.3); --globe-grid:rgba(24,39,46,.09); --foot-bg:#18272e; --foot-fg:#f3f1e9;
  color-scheme:light;
}
/* dark theme: --bg is the dark logo's own background, so the logo sits on the page without a box */
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#18272e;--bg-soft:#13212a;--ink:#edf1f5;--muted:#a6b1bc;--teal:#7ec7cc;--teal-strong:#7ec7cc;--teal-ink:#a9e1e3;--gold:#c5b46a;--gold-ink:#d6c57a;--blue:#8ea7c2;--line:rgba(237,241,245,.14);--on-accent:#0b161c;--nav-bg:rgba(24,39,46,.88);--hatch:rgba(237,241,245,.09);--open-bgc:rgba(237,241,245,.07);--course-bgc:rgba(126,199,204,.13);--key-bgc:rgba(197,180,106,.18);--talk-bgc:rgba(142,167,194,.13);--conn:rgba(237,241,245,.42);--globe-fill:rgba(255,255,255,.04);--globe-line:rgba(237,241,245,.28);--globe-grid:rgba(237,241,245,.08);--foot-bg:#0f1a20;--foot-fg:#edf1f5;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#18272e;--bg-soft:#13212a;--ink:#edf1f5;--muted:#a6b1bc;--teal:#7ec7cc;--teal-strong:#7ec7cc;--teal-ink:#a9e1e3;--gold:#c5b46a;--gold-ink:#d6c57a;--blue:#8ea7c2;--line:rgba(237,241,245,.14);--on-accent:#0b161c;--nav-bg:rgba(24,39,46,.88);--hatch:rgba(237,241,245,.09);--open-bgc:rgba(237,241,245,.07);--course-bgc:rgba(126,199,204,.13);--key-bgc:rgba(197,180,106,.18);--talk-bgc:rgba(142,167,194,.13);--conn:rgba(237,241,245,.42);--globe-fill:rgba(255,255,255,.04);--globe-line:rgba(237,241,245,.28);--globe-grid:rgba(237,241,245,.08);--foot-bg:#0f1a20;--foot-fg:#edf1f5;color-scheme:dark}
.lg-d{display:none}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .lg-l{display:none}:root:not([data-theme="light"]) .lg-d{display:block}}
:root[data-theme="dark"] .lg-l{display:none}:root[data-theme="dark"] .lg-d{display:block}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.55 var(--f-text);overflow-x:clip;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3,p{margin:0}
:focus-visible{outline:2px solid var(--teal-strong);outline-offset:3px;border-radius:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap{width:100%;max-width:1360px;margin:0 auto;padding:0 var(--gutter)}
.mono{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase}
.label{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--teal-ink)}
.skip{position:absolute;left:12px;top:-60px;background:var(--ink);color:var(--bg);padding:8px 14px;z-index:100;border-radius:4px}
.skip:focus{top:10px}
/* paper grain */
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:90;opacity:.05;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>")}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:.55em;padding:.78em 1.3em;border:1px solid var(--ink);border-radius:999px;background:transparent;color:var(--ink);
  font:500 .76rem/1 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:transform .25s,background .25s,color .25s}
.btn:hover{transform:translateY(-2px);background:var(--ink);color:var(--bg)}
.btn.solid{background:var(--teal-strong);border-color:var(--teal-strong);color:var(--on-accent)}
.btn.solid:hover{background:var(--ink);border-color:var(--ink)}
.btn.sm{padding:.62em 1em;font-size:.68rem}
.btn .ar{transition:transform .25s}.btn:hover .ar{transform:translate(2px,-2px)}

/* nav */
header.nav{position:fixed;inset:0 0 auto 0;z-index:70;background:var(--nav-bg);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:var(--nav-h);max-width:1360px;margin:0 auto;padding:0 var(--gutter)}
/* The PNG has generous built-in padding on the paper colour; negative margins let that padding overlap without cropping the file. */
.nav .logo img{width:128px;height:auto;margin:-18px 0 -18px -11px}
.nav ul{display:none;list-style:none;margin:0;padding:0;gap:28px}
.nav ul a{font:500 .74rem var(--f-mono);letter-spacing:.12em;text-transform:uppercase;text-decoration:none;padding:6px 0;background:linear-gradient(var(--teal-strong),var(--teal-strong)) 0 100%/0 1px no-repeat;transition:background-size .3s}
.nav ul a:hover{background-size:100% 1px}
.nav .right{display:flex;align-items:center;gap:10px}
.theme-btn{width:42px;height:42px;border:1px solid var(--ink);border-radius:50%;background:none;color:var(--ink);cursor:pointer;display:grid;place-items:center;padding:0;transition:background .25s,color .25s}
.theme-btn:hover{background:var(--ink);color:var(--bg)}
.menu-btn{width:42px;height:42px;border:1px solid var(--ink);border-radius:50%;background:none;cursor:pointer;display:grid;place-items:center;padding:0}
.menu-btn i{display:block;width:16px;height:1.5px;background:var(--ink);box-shadow:0 5px 0 var(--ink);transform:translateY(-2.5px);transition:.3s}
.nav.open .menu-btn i{box-shadow:none;transform:rotate(45deg)}
.nav.open ul{display:flex;flex-direction:column;position:absolute;top:var(--nav-h);left:0;right:0;background:var(--bg);padding:12px var(--gutter) 24px;border-bottom:1px solid var(--line);gap:4px}
.nav.open ul a{display:block;padding:12px 0;font-size:.85rem}
@media(min-width:900px){
  :root{--gutter:32px;--nav-h:64px}
  .nav ul{display:flex}.menu-btn{display:none}
  .nav .logo img{width:150px;margin:-21px 0 -21px -13px}
}

/* hero: copy left, one canvas right (brain + five distributions) */
.hero{position:relative;min-height:100svh;padding:calc(var(--nav-h) + 8px) 0 20px;overflow:clip;display:flex}
.hero>.wrap{display:flex}
.hero-grid{position:relative;display:flex;flex-direction:column;width:100%;gap:8px}
.hero-copy{position:relative;z-index:3;align-self:center;padding:4px 0}
/* logo PNG is padded; negative margins trim it. Width follows viewport height so it fits at 570px. */
.hero-logo{width:min(620px,100%,105vh);height:auto;margin:0 0 4px -2.8%}
h1.display{margin-top:14px;font:400 clamp(1.75rem,min(2.9vw,6.4vh),2.6rem)/1.08 var(--f-display);letter-spacing:-.03em;margin-left:-.03em}
h1 .mask{display:block;overflow:hidden;padding:.03em 0 .1em}
h1 .mask>span{display:inline-block}
h1 em{font-style:italic;color:var(--teal-ink);letter-spacing:-.035em}
.dateline{margin-top:6px;color:var(--teal-ink)}
.secondary{margin-top:12px;font:italic 400 clamp(1.1rem,min(2.2vw,3.4vh),1.4rem)/1.25 var(--f-display);max-width:44ch}
.when{margin-top:clamp(12px,3vh,26px);display:flex;flex-wrap:wrap;align-items:center;gap:8px 22px}
.bigdate{font:400 clamp(2rem,min(4.4vw,8.5vh),3.4rem)/1 var(--f-display);letter-spacing:-.025em;border-left:4px solid var(--gold);padding:2px 0 4px 14px;white-space:nowrap}
.venue-line{max-width:20ch;line-height:1.35;font-weight:500}
.cta{margin-top:clamp(12px,3vh,24px);display:flex;flex-wrap:wrap;gap:12px}
.cta .btn{font-size:.92rem;padding:1.05em 1.7em}
.brain-wrap{position:relative;flex:1;min-height:250px;z-index:1}
.brain-wrap canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
@media(min-width:900px){
  .hero-grid{flex-direction:row;gap:0;min-height:calc(100svh - var(--nav-h) - 28px)}
  .hero-copy{flex:1.05 1 0;min-width:0;padding-right:24px}
  .brain-wrap{flex:.95 1 0;min-width:0;min-height:0}
}

/* sections */
section{position:relative}
.sec{padding:72px 0}
.sec.soft{background:var(--bg-soft)}
.sec-head{display:flex;flex-direction:column;gap:10px;margin-bottom:36px;border-top:1px solid var(--ink);padding-top:14px}
.sec-head h2{font:400 clamp(1.9rem,3.6vw,2.75rem)/1.05 var(--f-display);letter-spacing:-.02em}
@media(min-width:900px){.sec-head{flex-direction:row;align-items:baseline;gap:32px}.sec-head .label{min-width:64px}}

/* course */
.about{display:grid;gap:32px}
.lede{font:300 clamp(1.3rem,2.2vw,1.75rem)/1.3 var(--f-display);letter-spacing:-.01em;max-width:34ch}
.facts{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}
.facts div{padding:16px 0;border-bottom:1px solid var(--line)}
.facts div:nth-child(odd){padding-right:16px;border-right:1px solid var(--line)}.facts div:nth-child(even){padding-left:20px}
.facts b{display:block;font:300 clamp(2.6rem,5vw,3.8rem)/1 var(--f-display);color:var(--teal-ink)}
.facts span{color:var(--muted);font-size:.95rem}
@media(min-width:900px){.about{grid-template-columns:1fr 1.1fr;gap:72px;align-items:end}}

/* speakers: globe + list */
.spk-wrap{display:grid;gap:28px;align-items:start}
.spk-intro{color:var(--muted);max-width:46ch;margin-bottom:18px}
.globe-wrap{position:relative;width:100%;max-width:620px;aspect-ratio:1;margin:0 auto}
.globe-wrap canvas{position:absolute;inset:0;width:100%;height:100%;cursor:grab;touch-action:pan-y}
.globe-wrap canvas:active{cursor:grabbing}
.spk-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.spk-list li{display:grid;grid-template-columns:1fr;gap:8px 16px;align-items:center;padding:14px 10px 14px 14px;border-bottom:1px solid var(--line);border-left:3px solid transparent;transition:background .25s,border-color .25s}
.spk-list li:hover,.spk-list li:focus-within{background:rgba(152,129,61,.1);border-left-color:var(--gold)}
.spk-list h3{font:400 1.5rem/1.1 var(--f-display);letter-spacing:-.01em}
.spk-list .role{display:block;margin-top:4px;color:var(--gold-ink);font-size:.68rem}
.spk-list .aff{color:var(--muted);font-size:.95rem;margin-top:2px}
.spk-list .btns{display:flex;flex-wrap:wrap;gap:6px}
.spk-list li.feat{padding:22px 10px 22px 14px;border-left-color:var(--gold-ink);background:rgba(152,129,61,.07)}
.spk-list li.feat h3{font-size:clamp(2rem,3.4vw,2.6rem);line-height:1}
@media(min-width:900px){
  .spk-wrap{grid-template-columns:1fr 1fr;gap:56px}
  .globe-wrap{position:sticky;top:calc(var(--nav-h) + 20px)}
}
@media(min-width:1100px){.spk-list li{grid-template-columns:1fr auto}.spk-list .btns{justify-content:flex-end}}

/* program: week grid. --ppm is pixels per minute; a block's top and height come from its start minute (--s, after 08:00) and duration (--d). */
.legend{display:flex;flex-wrap:wrap;gap:6px 20px;margin-bottom:16px;color:var(--muted);font-size:.68rem}
.legend i{display:inline-block;width:4px;height:12px;margin-right:8px;vertical-align:-2px;background:var(--c)}
.cal-scroll{overflow-x:auto;border-top:1px solid var(--ink);background:var(--bg)}
.cal{--ppm:1.8px;--axis:52px;min-width:720px}
.cal-head,.cal-body{display:grid;grid-template-columns:var(--axis) repeat(3,1fr)}
.cal-head{border-bottom:1px solid var(--line)}
.cal-head h3{display:flex;align-items:baseline;gap:10px;padding:14px 12px 12px;font:300 clamp(2.6rem,4.6vw,3.6rem)/1 var(--f-display);letter-spacing:-.02em}
.cal-head h3 span{font:500 .78rem var(--f-mono);letter-spacing:.14em;text-transform:uppercase;color:var(--teal-ink)}
.cal-body{position:relative;padding:10px 0;background:linear-gradient(var(--line) 1px,transparent 1px) 0 10px/100% calc(60 * var(--ppm)) repeat-y}
.axis,.cal-body ol{position:relative;height:calc(480 * var(--ppm));margin:0;padding:0;list-style:none}
.axis span{position:absolute;right:10px;top:calc(var(--m) * var(--ppm));transform:translateY(-50%);font:400 .68rem var(--f-mono);color:var(--muted);background:var(--bg);padding:0 2px}
.cal-body ol{border-left:1px solid var(--line)}
.blk{position:absolute;left:6px;right:6px;top:calc(var(--s) * var(--ppm) + 1px);height:calc(var(--d) * var(--ppm) - 2px);overflow:hidden;
  padding:6px 10px 4px;border-left:4px solid var(--c);background:linear-gradient(var(--bgc),var(--bgc)),var(--bg);line-height:1.2;z-index:1}
.blk time{display:block;font:500 .68rem var(--f-mono);letter-spacing:.06em;color:var(--muted)}
.blk b{display:block;font:400 1.15rem/1.12 var(--f-display);margin-top:2px}
.blk span{display:block;font-size:.84rem;color:var(--muted);margin-top:2px}
.blk em{font:italic 400 .9rem var(--f-display)}
.course{--c:var(--teal-strong);--bgc:var(--course-bgc)}
.keynote{--c:var(--gold);--bgc:var(--key-bgc)}
.talk{--c:var(--blue);--bgc:var(--talk-bgc)}
.open{--c:var(--ink);--bgc:var(--open-bgc)}
.brk{display:flex;align-items:center;gap:10px;padding:0 10px;border:0;background:repeating-linear-gradient(135deg,transparent 0 6px,var(--hatch) 6px 7px),var(--bg);color:var(--muted)}
.brk time,.brk b{display:inline;margin:0;font:500 .66rem var(--f-mono);letter-spacing:.06em;text-transform:uppercase}
.lunch{position:absolute;left:calc(var(--axis) + 6px);right:6px;top:calc(10px + 240 * var(--ppm) + 1px);height:calc(120 * var(--ppm) - 2px);display:flex;align-items:center;justify-content:center;gap:12px;
  background:var(--bg) repeating-linear-gradient(135deg,transparent 0 6px,var(--hatch) 6px 7px);color:var(--muted)}
.lunch b{font:500 .74rem var(--f-mono);letter-spacing:.14em;text-transform:uppercase;background:var(--bg);padding:3px 8px}
.note{margin-top:18px;color:var(--muted);font-size:.92rem}

/* committee */
.com-grid{display:grid;gap:0 32px;grid-template-columns:1fr;border-top:1px solid var(--line)}
.com{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid var(--line)}
.com h3{font:400 1.35rem/1.1 var(--f-display)}
@media(min-width:700px){.com-grid{grid-template-columns:1fr 1fr}}
@media(min-width:1100px){.com-grid{grid-template-columns:repeat(3,1fr)}}

/* venue */
.venue{display:grid;gap:36px}
.venue h3{font:400 clamp(1.5rem,2.4vw,1.9rem)/1.1 var(--f-display);margin:8px 0 10px}
.venue p{color:var(--muted);max-width:40ch}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.qr{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-top:18px}
.qr img{width:140px;height:140px;border-radius:4px;background:#fff;padding:8px;border:1px solid var(--line)}
.partners{margin-top:56px}
.p-grid{display:grid;gap:16px;grid-template-columns:1fr 1fr;margin-top:16px}
.p-grid figure{margin:0}
.p-grid .tile{background:#fff;border:1px solid var(--line);border-radius:6px;height:100px;display:grid;place-items:center;padding:12px}
.p-grid img{max-height:76px;width:auto;object-fit:contain}
.p-grid figcaption{margin-top:8px;font-size:.85rem;line-height:1.35;color:var(--muted)}
@media(min-width:900px){.venue{grid-template-columns:1fr 1fr;gap:64px}.p-grid{grid-template-columns:repeat(4,1fr)}}

/* footer */
footer{background:var(--foot-bg);color:var(--foot-fg);padding:48px 0 52px}
footer .big{font:300 clamp(1.6rem,3.4vw,2.6rem)/1.1 var(--f-display);letter-spacing:-.02em;max-width:24ch}
footer .big em{color:#a9d3d4}
footer .cols{display:flex;flex-wrap:wrap;gap:10px 36px;margin-top:24px;font:500 .74rem var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:#c8d1d4}
footer .copy{margin-top:28px;padding-top:14px;border-top:1px solid rgba(243,241,233,.2);font:400 .76rem var(--f-mono);color:#c8d1d4}

.proto{position:fixed;left:12px;bottom:12px;z-index:80;background:var(--ink);color:var(--bg);padding:7px 12px;border-radius:999px;font:500 .64rem var(--f-mono);letter-spacing:.12em;text-transform:uppercase}

@media(prefers-reduced-motion:reduce){
  .btn,.spk-list li{transition:none}
}
</style>
</head>
