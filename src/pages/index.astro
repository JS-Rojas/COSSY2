// outside the disc: that is what made the OIST arc loop out behind the globe before.
function view(v) {
  const c = Math.cos(lon0), s = Math.sin(lon0);
  const x1 = v[0] * c + v[1] * s, y1 = -v[0] * s + v[1] * c, z1 = v[2];
  const ct = Math.cos(TILT), st = Math.sin(TILT);
  const depth = x1 * ct + z1 * st, sy = z1 * ct - x1 * st;
  return { x: y1, y: sy, d: depth, vis: depth > 0 };
}
function line(ctx, pts, R, cx, cy) { // draw polyline, breaking where points are hidden; clipped to the globe disc
  ctx.save(); ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU); ctx.clip();
  let pen = false; ctx.beginPath();
  for (const p of pts) {
    if (!p.vis) { pen = false; continue; }
    const X = cx + p.x * R, Y = cy - p.y * R;
    pen ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y); pen = true;
  }
  ctx.stroke(); ctx.restore();
}
function arcPoints(a, b, n) {
  const om = Math.acos(clamp(a[0] * b[0] + a[1] * b[1] + a[2] * b[2], -1, 1)), so = Math.sin(om);
  const lift = .32 * Math.min(1, om / 1.6), out = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n, k1 = Math.sin((1 - t) * om) / so, k2 = Math.sin(t * om) / so, h = 1 + lift * Math.sin(Math.PI * t);
    out.push(view([(a[0] * k1 + b[0] * k2) * h, (a[1] * k1 + b[1] * k2) * h, (a[2] * k1 + b[2] * k2) * h]));
  }
  return out;
}
const placeOn = p => !!hl && p.names.some(n => n[0] === hl);
function drawGlobe(t) {
  const { ctx, w, h } = G;
  const hlPlace = PLACES.find(placeOn);
  if (hlPlace) { // turn the globe towards the highlighted speaker by the shortest way round
    const d = hlPlace.lon * D2R - lon0;
    lon0 += Math.atan2(Math.sin(d), Math.cos(d)) * (reduce ? 1 : .08);
  } else if (!drag && !reduce) lon0 += .0009;
  const R = w * .36, cx = w / 2, cy = h / 2;
  const ink = css("--ink"), teal = css("--teal-strong"), gold = css("--gold-ink"), plate = css("--bg-soft");
  ctx.clearRect(0, 0, w, h);
  ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU);
  ctx.fillStyle = css("--globe-fill"); ctx.fill();
  ctx.strokeStyle = css("--globe-line"); ctx.lineWidth = 1; ctx.stroke();
  // graticule every 30 degrees
  ctx.strokeStyle = css("--globe-grid");
  for (let lo = -180; lo < 180; lo += 30) { const pts = []; for (let la = -90; la <= 90; la += 6) pts.push(view(vec(la, lo))); line(ctx, pts, R, cx, cy); }
  for (let la = -60; la <= 60; la += 30) { const pts = []; for (let lo = -180; lo <= 180; lo += 6) pts.push(view(vec(la, lo))); line(ctx, pts, R, cx, cy); }
  // land dots, fading toward the limb
  ctx.fillStyle = teal;
  for (const v of land) {
    const p = view(v); if (p.d <= 0) continue;
    ctx.globalAlpha = .25 + .75 * p.d; ctx.beginPath(); ctx.arc(cx + p.x * R, cy - p.y * R, 1.5 + p.d * .6, 0, TAU); ctx.fill();
  }
  ctx.globalAlpha = 1;
  // arcs to Urcuquí; the highlighted one is drawn last and thicker
  ctx.strokeStyle = gold; ctx.lineCap = "round";
  const arcs = PLACES.filter(p => p.arc).sort((a, b) => placeOn(a) - placeOn(b));
  for (const p of arcs) {
    const on = placeOn(p);
    ctx.globalAlpha = on ? 1 : hl ? .22 : .6; ctx.lineWidth = on ? 3 : 1.6;
    line(ctx, arcPoints(p.v, HUB.v, 56), R, cx, cy);
  }
  ctx.globalAlpha = 1;
  // markers, then labels laid out per side so neighbours (Trieste, Palma) do not overlap
  const small = w < 420, fs = small ? 10 : 11, lh = fs + 3;
  const items = [];
  for (const p of PLACES) {
    const q = view(p.v); if (q.d < .05) continue;
    const X = cx + q.x * R, Y = cy - q.y * R, on = placeOn(p);
    const al = clamp(q.d * 3, 0, 1) * (hl && !on ? .4 : 1);
    ctx.globalAlpha = al;
    if (p.hub) {
      const ph = reduce ? 0 : (t / 1800) % 1;
      ctx.strokeStyle = teal; ctx.lineWidth = 1.5; ctx.globalAlpha = al * (1 - ph); ctx.beginPath(); ctx.arc(X, Y, 6 + ph * 16, 0, TAU); ctx.stroke(); ctx.globalAlpha = al;
    }
    ctx.fillStyle = p.hub ? teal : on ? gold : ink; ctx.beginPath(); ctx.arc(X, Y, p.hub ? 6 : on ? 5.5 : 3.5, 0, TAU); ctx.fill();
    if (on) { ctx.strokeStyle = gold; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(X, Y, 10, 0, TAU); ctx.stroke(); }
    ctx.globalAlpha = 1;
    // measure with the bold font so a highlighted label cannot grow past the edge
    ctx.font = `500 ${fs}px "IBM Plex Mono",monospace`;
    const tw = Math.max(...p.names.map(n => ctx.measureText(n[1]).width));
    let side = X > cx ? 1 : -1;
    if (side === 1 && X + 9 + tw > w - 2) side = -1;
    else if (side === -1 && X - 9 - tw < 2) side = 1;
    items.push({ p, X, Y, al, on, side, tw, hgt: p.names.length * lh, yc: Y });
  }
  for (const side of [-1, 1]) {
    const col = items.filter(i => i.side === side).sort((a, b) => a.Y - b.Y);
    col.forEach((it, i) => { if (i) { const pr = col[i - 1]; it.yc = Math.max(it.yc, pr.yc + pr.hgt / 2 + it.hgt / 2 + 2); } });
  }
  ctx.textBaseline = "middle";
  for (const it of items) {
    ctx.textAlign = it.side === 1 ? "left" : "right";
    it.p.names.forEach(([id, label], i) => {
      const lit = hl === id;
      ctx.font = `${lit || it.p.hub ? 600 : 500} ${fs}px "IBM Plex Mono",monospace`;
      const tx = it.X + it.side * 10, ty = it.yc - it.hgt / 2 + (i + .5) * lh, tw = ctx.measureText(label).width;
      ctx.globalAlpha = it.al * .8; ctx.fillStyle = plate;
      ctx.fillRect(it.side === 1 ? tx - 3 : tx - tw - 3, ty - lh / 2, tw + 6, lh);
      ctx.globalAlpha = it.al; ctx.fillStyle = lit ? gold : ink;
      ctx.fillText(label, tx, ty);
    });
  }
  ctx.globalAlpha = 1;
}
let lastX = 0;
gCan.addEventListener("pointerdown", e => { drag = true; lastX = e.clientX; gCan.setPointerCapture(e.pointerId); });
gCan.addEventListener("pointermove", e => { if (!drag) return; lon0 -= (e.clientX - lastX) / (G.w * .36); lastX = e.clientX; if (reduce) drawGlobe(0); });
["pointerup", "pointercancel"].forEach(ev => gCan.addEventListener(ev, () => { drag = false; }));
buildGlobe();
onResize(gCan, buildGlobe);
if (!reduce) runWhenVisible(gCan, drawGlobe);
// list rows drive the highlight; hovering or focusing a row turns the globe to that speaker
function setHl(id) { hl = id; if (reduce && G) drawGlobe(0); }
$$("#spkList li").forEach(li => {
  li.addEventListener("mouseenter", () => setHl(li.dataset.id));
  li.addEventListener("mouseleave", () => setHl(null));
  li.addEventListener("focusin", () => setHl(li.dataset.id));
  li.addEventListener("focusout", e => { if (!li.contains(e.relatedTarget)) setHl(null); });
});

/* ---------- program: week grid ----------
   Times are minutes after 08:00. Example: the 14:00 keynote starts at 360 and lasts 50, so its top is 360 * 1.8px = 648px
   and its height 90px inside an 864px day. The same morning repeats each day. Wide screens draw Lunch once across the
   three days. Phones show one day at a time, with day tabs, so there each day has its own Lunch block. */
const hm = m => { m += 480; return String(m / 60 | 0).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0"); };
const MORNING = [[30, 90, "course", "Intro to Probability", "Antonio Villagomez (UV, Chile)", "", "c1"], [120, 30, "brk", "Coffee break"],
  [150, 90, "course", "Models from Information Principles", "Juan Velez (OIST, Japan)", "", "c2"], [240, 120, "brk lunch-d", "Lunch"]];
const DAYS = [
  { n: 14, dow: "Mon", name: "Monday", pre: [[0, 30, "open", "Opening Ceremony"]], pm: ["keynote", "Keynote Lecture 1", "Matteo Marsili (ICTP, Italy)", "Lost in Retraining", "k1"], tk: ["Talk 1", "Arianna Paredes (SISSA · OGS, Italy)", "t1"] },
  { n: 15, dow: "Tue", name: "Tuesday", pre: [], pm: ["talk", "Talk 2", "Mario Cosenza (Yachay Tech, Ecuador)", "", "t2"], tk: ["Talk 3", "María José Ayala Bolagay (USP, Brazil)", "t3"] },
  { n: 16, dow: "Wed", name: "Wednesday", pre: [], pm: ["keynote", "Keynote Lecture 2", "William Bialek (Princeton, USA)", "", "k2"], tk: ["Talk 4", "Mateo Carpio (IFISC, Spain)", "t4"] }];
// A course repeats every day; only its first block carries the id that the speaker list links to.
function blk([s, d, type, title, who, quote, id], firstDay) {
  const time = `<time>${hm(s)}–${hm(s + d)}</time>`;
  if (type.startsWith("brk")) return `<li class="blk ${type}" style="--s:${s};--d:${d}">${time}<b>${title}</b></li>`;
  const anchor = id && (firstDay || id[0] !== "c") ? ` id="b-${id}"` : "";
  return `<li class="blk ${type}"${anchor} style="--s:${s};--d:${d}">${time}<b>${title}</b>${quote ? `<span><em>“${quote}”</em></span>` : ""}${who ? `<span>${who}</span>` : ""}</li>`;
}
$("#cal").innerHTML =
  `<div class="cal-tabs" id="calTabs">${DAYS.map((d, i) => `<button type="button" data-i="${i}" aria-current="${i === 0}"><b>${d.n}</b>${d.dow}<span class="sr"> December</span></button>`).join("")}</div>
   <div class="cal-head" aria-hidden="true"><span></span>${DAYS.map(d => `<h3>${d.n}<span>${d.name}</span></h3>`).join("")}</div>
   <div class="cal-grid">
     <div class="axis" aria-hidden="true">${Array.from({ length: 9 }, (_, i) => `<span style="--m:${i * 60}">${hm(i * 60)}</span>`).join("")}</div>
     <div class="days" id="days" data-lenis-prevent-horizontal>
       ${DAYS.map((d, i) => `<section class="day" aria-label="${d.name} ${d.n} December 2026"><ol>${[...d.pre, ...MORNING,
          [360, 50, ...d.pm], [410, 20, "brk", "Coffee break"], [430, 50, "talk", d.tk[0], d.tk[1], "", d.tk[2]]].map(b => blk(b, i === 0)).join("")}</ol></section>`).join("")}
       <p class="lunch"><span><b>Lunch</b><time>12:00–14:00, every day</time></span></p>
     </div>
   </div>`;
// Phone only: the tabs move the snap scroller, and swiping it updates the tabs.
const days = $("#days"), calTabs = $$("#calTabs button");
const goDay = i => days.scrollTo({ left: i * days.clientWidth, behavior: reduce ? "auto" : "smooth" });
calTabs.forEach(b => b.addEventListener("click", () => goDay(+b.dataset.i)));
let dayRaf = 0;
days.addEventListener("scroll", () => {
  if (dayRaf) return;
  dayRaf = requestAnimationFrame(() => {
    dayRaf = 0;
    const i = Math.round(days.scrollLeft / days.clientWidth);
    calTabs.forEach((b, k) => b.setAttribute("aria-current", String(k === i)));
  });
}, { passive: true });
// A speaker's time slot brings its day into view on a phone, then marks the block.
function showBlock(b) {
  if (days.scrollWidth > days.clientWidth + 4) goDay([...days.children].indexOf(b.closest(".day")));
  b.classList.remove("flash"); void b.offsetWidth; b.classList.add("flash");
}

/* ---------- committee ---------- */
$("#com").innerHTML = Array.from({ length: 6 }, () =>
  `<article class="com"><h3>Committee member</h3></article>`).join("");

/* ---------- entrance + scroll reveals ---------- */
if (hasG && !reduce) {
  const tl = gsap.timeline({ defaults: { ease: "power3.out", duration: .8 } });
  tl.from(".lockup", { y: 18, opacity: 0 }, .1)
    .from(["h1.display", ".cta"], { y: 16, opacity: 0, stagger: .09 }, .24)
    .from(".fact", { y: 14, opacity: 0, stagger: .07 }, .45)
    .from(".brain-wrap", { opacity: 0, duration: 1.2 }, .3);
  if (hasST) $$("[data-reveal]").forEach(el => gsap.from(el, { y: 22, opacity: 0, duration: .7, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 94%", once: true } }));
}
})();
</script>
</body>
