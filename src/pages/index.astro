  }
  ctx.stroke();
}
function drawConnectors(ctx) {
  ctx.save();
  ctx.strokeStyle = cConn; ctx.lineWidth = 1.55; ctx.setLineDash([8, 10]);
  for (const zone of zones) {
    const dx = zone.anchor.x - zone.x, dy = zone.anchor.y - zone.y;
    ctx.beginPath(); ctx.moveTo(zone.x, zone.y);
    ctx.quadraticCurveTo(zone.x + dx * .54, zone.y + dy * .42, zone.anchor.x, zone.anchor.y);
