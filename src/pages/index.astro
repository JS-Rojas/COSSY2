<script is:inline>
(() => {
const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const clamp = (x, a, b) => Math.max(a, Math.min(b, x));
const lerp = (a, b, t) => a + (b - a) * t;
const TAU = Math.PI * 2;
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const hasG = !!window.gsap;
const hasST = hasG && !!window.ScrollTrigger;
if (hasST) gsap.registerPlugin(ScrollTrigger);

/* ---------- smooth scroll + anchors ---------- */
let lenis = null;
if (!reduce && window.Lenis) {
  lenis = new Lenis();
  if (hasST) {
    lenis.on("scroll", ScrollTrigger.update);
    gsap.ticker.add(t => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);
  } else {
    const r = t => { lenis.raf(t); requestAnimationFrame(r); };
    requestAnimationFrame(r);
  }
}
const nav = $("#nav"), menuBtn = $("#menuBtn");
const closeMenu = () => { nav.classList.remove("open"); menuBtn.setAttribute("aria-expanded", "false"); };
menuBtn.addEventListener("click", () => {
  const open = nav.classList.toggle("open");
  menuBtn.setAttribute("aria-expanded", open);
});
// The bar is clear over the hero. It gains its ground once the page moves, and the small logo docks in once the big one has left.
const heroLogos = $$(".hero-logo");
function navState() {
  nav.classList.toggle("scrolled", scrollY > 6);
  const big = heroLogos.find(el => el.offsetParent);
  nav.classList.toggle("docked", !big || big.getBoundingClientRect().bottom < nav.offsetHeight);
}
addEventListener("scroll", navState, { passive: true });
addEventListener("resize", navState);
navState();
// The menu underlines the section that sits in the middle of the screen. Over the hero, none.
const spy = $$("#menu a").map(a => [a, $(a.getAttribute("href"))]);
const spyIO = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) spy.forEach(([a, s]) => a.setAttribute("aria-current", String(s === e.target)));
}), { rootMargin: "-40% 0px -55% 0px" });
[$("#top"), ...spy.map(x => x[1])].forEach(s => spyIO.observe(s));

function scrollToEl(el, offset) {
  if (lenis) lenis.scrollTo(el, { offset });
  else scrollTo({ top: el.getBoundingClientRect().top + scrollY + offset, behavior: reduce ? "auto" : "smooth" });
}
// In-page links. A speaker's time slot (data-go) goes to its block in the program and marks it for a moment.
document.addEventListener("click", e => {
  const a = e.target.closest("a");
  if (!a) return;
  const id = a.getAttribute("href");
  if (!id || id.length < 2 || id[0] !== "#") return;
  const block = a.dataset.go ? $("#b-" + a.dataset.go) : null, el = block || $(id);
  if (!el) return;
  e.preventDefault();
